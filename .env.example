# Generate each with: openssl rand -hex 32
STORE_MASTER_KEY=
INGEST_SECRET=

# Optional — defaults shown
MCP_PORT=8080
TOKEN_REFRESH_INTERVAL=4h
DB_PATH=data/sessions.db
INGEST_RATE_LIMIT_MAX=10
INGEST_RATE_LIMIT_WINDOW=1m

# Optional Blinkit search fallback (browser-backed, Playwright)
# BLINKIT_SEARCH_MODE=browser
# BLINKIT_BROWSER_HELPER=scripts/blinkit-browser-search.mjs
# BLINKIT_BROWSER_NODE=node
# BLINKIT_BROWSER_TIMEOUT=45s
# BLINKIT_BROWSER_WORKER_URL=http://127.0.0.1:42199
# BLINKIT_BROWSER_PROFILE_DIR=.data/blinkit-browser-profile
# BLINKIT_BROWSER_HEADLESS=true
# BLINKIT_BROWSER_TIMEOUT_MS=45000
# BLINKIT_BROWSER_BOOTSTRAP_TIMEOUT=5m
# BLINKIT_BROWSER_BOOTSTRAP_TIMEOUT_MS=300000
# BLINKIT_BROWSER_WORKER_PORT=42199
# BLINKIT_BROWSER_WORKER_BIND=127.0.0.1
# Optional: public MCP base URL used to build phone-openable login portal links
# MCP_PUBLIC_BASE_URL=https://agent.example.com
# Optional: URL surfaced by start_login for external login handoff UX
# BLINKIT_EXTERNAL_LOGIN_URL=https://blinkit.com/
# Optional: templated remote-browser URL used by the login portal / start_login
# Supported placeholders: {login_id}, {login_id_escaped}, {app}, {target_url}, {target_url_escaped}
# BLINKIT_EXTERNAL_LOGIN_URL_TEMPLATE=https://login.example.com/vnc.html?login_id={login_id_escaped}&target={target_url_escaped}
# Optional: route browser traffic via compliant proxy egress (VPS-only fallback)
# BLINKIT_BROWSER_PROXY_SERVER=http://proxy.example:3128
# BLINKIT_BROWSER_PROXY_USERNAME=
# BLINKIT_BROWSER_PROXY_PASSWORD=
