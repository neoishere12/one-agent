# Generate each with: openssl rand -hex 32
STORE_MASTER_KEY=
INGEST_SECRET=

# Optional — defaults shown
MCP_PORT=8080
TOKEN_REFRESH_INTERVAL=4h
DB_PATH=data/sessions.db
INGEST_RATE_LIMIT_MAX=10
INGEST_RATE_LIMIT_WINDOW=1m

# Optional Blinkit search fallback (browser-backed, Playwright)
# BLINKIT_SEARCH_MODE=browser
# BLINKIT_BROWSER_HELPER=scripts/blinkit-browser-search.mjs
# BLINKIT_BROWSER_NODE=node
# BLINKIT_BROWSER_TIMEOUT=45s
# BLINKIT_BROWSER_WORKER_URL=http://127.0.0.1:42199
# BLINKIT_BROWSER_PROFILE_DIR=.data/blinkit-browser-profile
# BLINKIT_BROWSER_HEADLESS=true
# BLINKIT_BROWSER_TIMEOUT_MS=45000
# BLINKIT_BROWSER_BOOTSTRAP_TIMEOUT=5m
# BLINKIT_BROWSER_BOOTSTRAP_TIMEOUT_MS=300000
# BLINKIT_BROWSER_WORKER_PORT=42199
# BLINKIT_BROWSER_WORKER_BIND=127.0.0.1
